# Copia questo file in .env e modifica le credenziali prima del primo avvio.
# Mantieni COMPOSE_PROJECT_NAME=php-dev per riutilizzare il volume creato
# dalla configurazione Docker precedente del progetto.
COMPOSE_PROJECT_NAME=php-dev

# Percorso locale del codice PHP (montato nel container senza copiarlo nell'immagine).
APP_PATH=./src

# Porte pubblicate sul computer locale.
WEB_PORT=8080
DB_HOST_PORT=3307
PMA_PORT=8081

# Versioni delle immagini.
APACHE_VERSION=2.4
PHP_VERSION=8.5
MARIADB_VERSION=11.8
PHPMYADMIN_VERSION=5.2-apache

# Connessione PHP -> MariaDB sulla rete Docker.
DB_HOST=database
DB_PORT=3306
DB_NAME=app_database
DB_USER=app_user
DB_PASSWORD=change_this_app_password
DB_ROOT_PASSWORD=change_this_root_password
